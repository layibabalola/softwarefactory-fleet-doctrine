{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/cloudvore/provider-governor/cloudvore-shadow-profile-v1.schema.json",
  "title": "Cloudvore provider-governor SHADOW adoption profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_status",
    "source_design",
    "accepted_reconciliation",
    "accepted_contract",
    "activation",
    "portable_contract",
    "provider_adapters",
    "deterministic_router",
    "translation_boundary",
    "evidence_capsule",
    "usage_event_types",
    "source_exclusions",
    "no_authority"
  ],
  "properties": {
    "schema": {"const": "cloudvore-provider-governor-shadow-profile/v1"},
    "proposal_status": {"const": "PROPOSED_ZERO_AUTHORITY"},
    "source_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"const": "cloudvore/provider-governor/provenance/HUB-DESIGN-provider-capacity-governor-shadow-adoption-0818.md"},
        "sha256": {"const": "424a56c8700813c06bf31ac3b5b8c34b323f1ef6b1f38685e51bb89764957887"},
        "size_bytes": {"const": 17321}
      }
    },
    "accepted_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_commit", "candidate_tree", "candidate_parent", "manifest_blob", "manifest_sha256", "canonical_merge", "project_profile", "authority"],
      "properties": {
        "candidate_commit": {"$ref": "#/$defs/gitSha"},
        "candidate_tree": {"$ref": "#/$defs/gitSha"},
        "candidate_parent": {"$ref": "#/$defs/gitSha"},
        "manifest_blob": {"$ref": "#/$defs/gitSha"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_merge": {"$ref": "#/$defs/gitSha"},
        "project_profile": {"$ref": "#/$defs/projectPath"},
        "authority": {"const": "PORTABLE_DOCTRINE_ONLY"}
      }
    },
    "accepted_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "parent", "ruling_commit", "ruling_merge", "ruling_blob", "ruling_blob_sha256", "declared_tuple_status", "declared_tuple_checks", "artifact_manifest"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "parent": {"$ref": "#/$defs/gitSha"},
        "ruling_commit": {"$ref": "#/$defs/gitSha"},
        "ruling_merge": {"$ref": "#/$defs/gitSha"},
        "ruling_blob": {"$ref": "#/$defs/gitSha"},
        "ruling_blob_sha256": {"$ref": "#/$defs/sha256"},
        "declared_tuple_status": {"const": "BLOCKED_TWO_RULING_MISMATCHES_ONE_PRIOR_PROFILE_TRANSCRIPTION_MISMATCH"},
        "declared_tuple_checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/declaredTupleCheck"}
        },
        "artifact_manifest": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stage", "automatic_launch_gate", "fleet_stage_order", "evidence_gates", "reset_may_advance_stage", "canary_requires_separate_authority", "enabled_requires_project_adopt_disposition"],
      "properties": {
        "current_stage": {"const": "HARD_CLOSED"},
        "automatic_launch_gate": {"const": "closed"},
        "fleet_stage_order": {"const": ["HARD_CLOSED", "INSTALLED_UNVERIFIED", "SHADOW", "CONTAINMENT", "CANARY", "ENABLED"]},
        "evidence_gates": {"const": ["SHADOW_PASS", "CONTAINMENT_PASS", "CAPACITY_PASS", "CONTEXT_PASS", "ROUTING_PASS"]},
        "reset_may_advance_stage": {"const": false},
        "canary_requires_separate_authority": {"const": true},
        "enabled_requires_project_adopt_disposition": {"const": true}
      }
    },
    "portable_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_supervisor_per_quota_domain", "deterministic_zero_inference_idle", "exact_profile_preserved", "silent_downgrade_allowed", "provider_adapters_translate_only", "capacity_reset_is_telemetry_only"],
      "properties": {
        "one_supervisor_per_quota_domain": {"const": true},
        "deterministic_zero_inference_idle": {"const": true},
        "exact_profile_preserved": {"const": true},
        "silent_downgrade_allowed": {"const": false},
        "provider_adapters_translate_only": {"const": true},
        "capacity_reset_is_telemetry_only": {"const": true}
      }
    },
    "provider_adapters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/providerAdapter"}
    },
    "deterministic_router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observed_sha256", "authority"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "observed_sha256": {"$ref": "#/$defs/sha256"},
        "authority": {"const": "PLAN_ONLY_NOT_ADMISSION_SUPERVISOR"}
      }
    },
    "translation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_translate", "must_not_translate"],
      "properties": {
        "may_translate": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "must_not_translate": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}}
      }
    },
    "evidence_capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_json", "content_addressed", "max_payload_bytes", "max_references", "silent_required_evidence_truncation_allowed", "overflow_terminal"],
      "properties": {
        "canonical_json": {"const": true},
        "content_addressed": {"const": true},
        "max_payload_bytes": {"type": "integer", "minimum": 1024, "maximum": 262144},
        "max_references": {"type": "integer", "minimum": 1, "maximum": 256},
        "silent_required_evidence_truncation_allowed": {"const": false},
        "overflow_terminal": {"const": "CAPSULE_REQUIRED_EVIDENCE_OVERFLOW"}
      }
    },
    "usage_event_types": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"enum": ["ADMISSION_REQUESTED", "ADMISSION_ADMITTED", "ADMISSION_DENIED", "PROCESS_STARTED", "USAGE_OBSERVED", "CHECKPOINTED", "TERMINAL", "CAPACITY_BLOCKED", "RESET_OBSERVED", "IDLE_SKIPPED", "UNPARSEABLE"]}
    },
    "source_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_from_admission_authority", "score_or_grade_may_authorize", "doctrine_write_may_authorize_runtime", "publication_may_authorize_runtime"],
      "properties": {
        "excluded_from_admission_authority": {"const": ["score", "grade", "doctrine_write", "publication"]},
        "score_or_grade_may_authorize": {"const": false},
        "doctrine_write_may_authorize_runtime": {"const": false},
        "publication_may_authorize_runtime": {"const": false}
      }
    },
    "no_authority": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
    }
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectPath": {"type": "string", "pattern": "^[a-z0-9._-]+(?:/[a-zA-Z0-9._*-]+)+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "declaredTupleCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "prior_profile_sha256", "source_design_sha256", "source_design_size_bytes", "ruling_declared_sha256", "ruling_declared_size_bytes", "git_object_sha256", "git_object_size_bytes", "classification"],
      "properties": {
        "path": {"enum": ["README.md", "metrics/README.md", "examples/provider-usage-events-v1.jsonl"]},
        "prior_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64,65}$"},
        "source_design_sha256": {"type": "string", "pattern": "^[0-9a-f]{64,65}$"},
        "source_design_size_bytes": {"type": "integer", "minimum": 0},
        "ruling_declared_sha256": {"$ref": "#/$defs/sha256"},
        "ruling_declared_size_bytes": {"type": "integer", "minimum": 0},
        "git_object_sha256": {"$ref": "#/$defs/sha256"},
        "git_object_size_bytes": {"type": "integer", "minimum": 0},
        "classification": {"enum": ["RULING_TUPLE_MISMATCH", "PRIOR_PROFILE_TRANSCRIPTION_ONLY"]}
      }
    },
    "providerAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "lanes", "launch_seam", "observed_launcher_sha256", "current_conformance"],
      "properties": {
        "family": {"enum": ["anthropic", "openai", "moonshot", "xai"]},
        "lanes": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
        "launch_seam": {"type": "string", "minLength": 1},
        "observed_launcher_sha256": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "current_conformance": {"const": "PENDING_LOCAL_SUPERVISOR_AND_DRILLS"}
      }
    }
  }
}
