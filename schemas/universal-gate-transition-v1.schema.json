{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-gate-transition-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transitionId", "transitionEpoch", "issuedAt", "expiresAt", "from", "to", "cause", "doctrineCommitSha256", "brokerExecutableSha256", "projectProfileSha256", "inventorySha256", "brokerHealthSha256", "reviewReceiptSha256", "testReceiptSha256", "stageProof", "authorizationHmacSha256"],
  "properties": {
    "schema": {"const": "fleet-universal-gate-transition/v1"},
    "transitionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "transitionEpoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "from": {"enum": ["CLOSED", "SHADOW", "CONTAINMENT", "CANARY", "OPEN"]},
    "to": {"enum": ["CLOSED", "SHADOW", "CONTAINMENT", "CANARY", "OPEN"]},
    "cause": {"enum": ["INDEPENDENT_ADJUDICATION", "SAFETY_CLOSE"]},
    "doctrineCommitSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "brokerExecutableSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "projectProfileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inventorySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "brokerHealthSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewReceiptSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "testReceiptSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stageProof": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "proofId", "proofType", "issuedAt", "expiresAt", "targetStage", "priorTransitionSha256", "projectProfileSha256", "inventorySha256", "hostedNegativeSuiteSha256", "independentReviewSha256", "canarySuccessReceiptSha256", "oneUse", "proofHmacSha256"],
      "properties": {
        "schema": {"const": "fleet-universal-stage-proof/v1"},
        "proofId": {"type": "string", "pattern": "^stage-[0-9a-f]{32}$"},
        "proofType": {"enum": ["SAFETY_CLOSE", "SHADOW_VALIDATION", "CONTAINMENT_ENFORCEMENT", "CANARY_READINESS", "CANARY_SUCCESS_ADJUDICATION"]},
        "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
        "targetStage": {"enum": ["CLOSED", "SHADOW", "CONTAINMENT", "CANARY", "OPEN"]},
        "priorTransitionSha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "projectProfileSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "inventorySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hostedNegativeSuiteSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "independentReviewSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "canarySuccessReceiptSha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "oneUse": {"const": true}, "proofHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
      }
    },
    "authorizationHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
