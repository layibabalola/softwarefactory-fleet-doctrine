{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-process-tree-termination-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "leaseId", "bindingSha256", "observedAt", "expiresAt", "rootProcessId", "rootProcessStartTime", "rootExited", "liveDescendantCount", "observerQualified", "observerId", "observerKeySha256", "evidencePath", "evidenceSha256", "retainedEvidenceBytes", "receiptHmacSha256"],
  "properties": {
    "schema": {"const": "fleet-universal-process-tree-termination-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^termination-[0-9a-f]{32}$"},
    "leaseId": {"type": "string", "pattern": "^lease-[0-9a-f]{32}$"},
    "bindingSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "rootProcessId": {"type": "integer", "minimum": 1},
    "rootProcessStartTime": {"type": "string", "format": "date-time"},
    "rootExited": {"const": true},
    "liveDescendantCount": {"const": 0},
    "observerQualified": {"const": true},
    "observerId": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,63}$"},
    "observerKeySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidencePath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidenceSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "retainedEvidenceBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "receiptHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
