{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-terminal-request-permit-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "permitId", "leaseId", "requestId", "issuedAt", "expiresAt", "terminalRequestCount", "terminalReserveTokens", "ordinaryOutputCeiling", "bindingSha256", "permitHmacSha256"],
  "properties": {
    "schema": {"const": "fleet-universal-terminal-request-permit/v1"},
    "permitId": {"type": "string", "pattern": "^terminal-[0-9a-f]{32}$"},
    "leaseId": {"type": "string", "pattern": "^lease-[0-9a-f]{32}$"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "terminalRequestCount": {"const": 1},
    "terminalReserveTokens": {"type": "integer", "minimum": 1},
    "ordinaryOutputCeiling": {"type": "integer", "minimum": 0},
    "bindingSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permitHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
