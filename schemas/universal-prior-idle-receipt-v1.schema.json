{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-prior-idle-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "project", "recordedAt", "expiresAt", "sequence", "authorityPath", "authoritySha256", "demandSnapshot", "demandFingerprint", "demandAuthorityPinEpoch", "demandAuthorityPinHmacSha256", "stateRootIdentity", "receiptHmacSha256"],
  "properties": {
    "schema": {"const": "fleet-universal-prior-idle-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^idle-[0-9a-f]{32}$"},
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "authorityPath": {"type": "string", "minLength": 1, "maxLength": 4096},
    "authoritySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "demandSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "project", "addressedWork", "cursor"],
      "properties": {
        "schema": {"const": "fleet-universal-demand-snapshot/v1"},
        "project": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "addressedWork": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "object"}},
        "cursor": {"type": "object"}
      }
    },
    "demandFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "demandAuthorityPinEpoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "demandAuthorityPinHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "stateRootIdentity": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"},
    "receiptHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
