{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-provider-review-admission-v1.schema.json",
  "title": "Universal provider review admission policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "source", "identity", "packet", "serialization", "tokenizer", "charges", "capacity", "tools", "capabilities", "lease", "request", "terminal", "conformance"],
  "properties": {
    "schema": {"const": "fleet-universal-provider-review-admission/v1"},
    "status": {"const": "CANDIDATE_ZERO_AUTHORITY_HARD_CLOSED"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["providerExecution", "processMutation", "gateMutation", "adoptionCredit", "runtimeImplementation", "authorRecused"],
      "properties": {
        "providerExecution": {"const": false}, "processMutation": {"const": false},
        "gateMutation": {"const": false}, "adoptionCredit": {"const": false},
        "runtimeImplementation": {"const": "NOT_INSTALLED_UNCONDITIONAL_REFUSE"},
        "authorRecused": {"const": true}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "orderedParents", "subjectFiles"],
      "properties": {
        "repository": {"const": "https://github.com/layibabalola/Cloudvore.git"},
        "commit": {"const": "46674bf7ba004dd6c4cac69d5a26369ab11106c4"},
        "tree": {"const": "bef6f545f773157807e81dcf71305cb13a25382e"},
        "orderedParents": {"const": ["8dcd3393f5541aa1f7fe181c3869f4262b6e1a00"]},
        "subjectFiles": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {"$ref": "#/$defs/subject"}
        }
      }
    },
    "identity": {
      "const": {
        "model": "claude-fable-5", "effort": "max", "serviceTier": "standard",
        "transport": "firstParty", "role": "INDEPENDENT_ADVERSARIAL_REVIEWER",
        "question": "Review the exact seven-file Cloudvore provider-governor proposal for security, doctrine conformance, quality preservation, and fail-closed resource admission; return PASS or actionable findings with file and failure scenario.",
        "nativeMaxOutputTokens": 64000, "substitutionAllowed": false
      }
    },
    "packet": {
      "const": {
        "schema": "fleet-review-capsule/v1", "canonicalEncoding": "UTF8_NO_BOM_SORTED_KEYS_COMPACT_LF",
        "allAndOnlyOrderedSubjectBijection": true, "gitAndCommittedManifestBinding": true,
        "metadataInstructionFieldsAllowed": false, "silentTruncationAllowed": false,
        "maxCapsuleBytes": 65536, "maxCapsules": 4, "maxTotalCapsuleBytes": 262144
      }
    },
    "serialization": {
      "const": {
        "schema": "fleet-provider-final-review-request/v1", "internallyDerivedOnly": true,
        "callerSerializationAccepted": false, "hiddenPrefixAllowed": false,
        "countedParts": ["SYSTEM_PREFIX", "PROVIDER_PREFIX", "TRANSPORT_FRAMING", "PROMPT", "CAPSULES", "OUTPUT_PARAMETER", "TOOL_CONFIGURATION"]
      }
    },
    "tokenizer": {
      "const": {
        "trustedVersionAndArtifactRequired": true, "exactFinalRequestBytesRequired": true,
        "maxExactSerializedInputTokens": 128000, "heuristicByteFallbackAllowed": false,
        "unknownOrMismatch": "REFUSE"
      }
    },
    "charges": {
      "const": {
        "trustedProviderNativeFunctionRequired": true,
        "dimensions": ["input", "cacheRead", "cacheCreationOrWrite", "output", "reasoning", "otherChargedDimensions"],
        "typedFiniteNonnegative": true, "nativeOutputAllowanceCharged": 64000,
        "cacheDisabledOrExactlyBounded": true, "unknownNeverZero": true
      }
    },
    "capacity": {
      "const": {
        "allQuotaWindows": true, "completionReserveRequired": true,
        "foregroundReserveRequired": true, "reviewReserveRequired": true,
        "providerNativeReserveFloor": 0.2, "unknownOrStale": "REFUSE"
      }
    },
    "tools": {
      "const": {
        "providerDefinitions": [], "effectiveProviderTools": [], "effectiveLocalTools": [],
        "allowedTools": [], "allowedToolsSemantics": "APPROVAL_ONLY_NOT_CONTAINMENT",
        "hooks": [], "mcpServers": [], "discoveryAllowed": false,
        "duplicateOrConflictingFlagsAllowed": false
      }
    },
    "capabilities": {
      "const": {
        "providerHardOutputCapRequired": 64000, "fullChildTreeCustodyRequired": true,
        "handleBoundDeadlineSeconds": 3600, "missing": "REFUSE"
      }
    },
    "lease": {
      "const": {
        "scope": "ATOMIC_HOST_WIDE_QUOTA_DOMAIN", "acquireBeforeCensusAndCapacity": true,
        "revalidateImmediatelyBeforeSpawn": true, "holdThroughTerminalAccounting": true,
        "timeOnlyStealAllowed": false, "abaFields": ["ownerPid", "ownerProcessStartTime", "nonce", "generation"]
      }
    },
    "request": {
      "const": {
        "requestsPerAuthority": 1, "automaticRetry": false, "unevaluableConsumesAuthority": true,
        "freshAuthorityAfterUnevaluable": true, "qualityOrFunctionDowngradeAllowed": false
      }
    },
    "terminal": {
      "const": {
        "requestedAndEffectiveIdentityRequired": true, "allNativeUsageRequired": true,
        "unknownNeverZero": true, "identityMismatch": "UNEVALUABLE_ZERO_CREDIT",
        "accountBeforeLeaseRelease": true
      }
    },
    "conformance": {
      "const": {
        "adapterLabel": "CONFORMANCE_ONLY_ZERO_AUTHORITY", "productionAuthority": false,
        "admissionDecision": "REFUSE_RUNTIME_NOT_INSTALLED"
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "path", "gitBlobOid", "sha256", "bytes"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 6},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "gitBlobOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
