{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-provider-review-admission-v1.schema.json",
  "title": "Universal provider review admission policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority", "trust", "source", "identity", "packet", "serialization", "tokenizer", "charges", "capacity", "tools", "capabilities", "lease", "request", "terminal", "conformance"],
  "properties": {
    "schema": {"const": "fleet-universal-provider-review-admission/v1"},
    "status": {"const": "CANDIDATE_ZERO_AUTHORITY_HARD_CLOSED"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["providerExecution", "processMutation", "gateMutation", "adoptionCredit", "runtimeImplementation", "authorRecused"],
      "properties": {
        "providerExecution": {"const": false}, "processMutation": {"const": false},
        "gateMutation": {"const": false}, "adoptionCredit": {"const": false},
        "runtimeImplementation": {"const": "NOT_INSTALLED_UNCONDITIONAL_REFUSE"},
        "authorRecused": {"const": true}
      }
    },
    "trust": {
      "const": {
        "brokerOwnedVerifiedPolicyHandleRequired": true,
        "installManifestDigestRequired": true,
        "callerPolicyOrDigestAuthority": false,
        "currentProductionTrustRoot": "NOT_INSTALLED_REFUSE"
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "orderedParents", "subjectFiles"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "maxLength": 512},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "orderedParents": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "subjectFiles": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 0}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 1}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 2}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 3}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 4}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 5}}}]},
            {"allOf": [{"$ref": "#/$defs/subject"}, {"properties": {"ordinal": {"const": 6}}}]}
          ],
          "items": false
        }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "effort", "serviceTier", "transport", "role", "question", "nativeMaxOutputTokens", "substitutionAllowed", "loweringRequiresAcceptedNonInferiority"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "effort": {"type": "string", "minLength": 1, "maxLength": 64},
        "serviceTier": {"type": "string", "minLength": 1, "maxLength": 64},
        "transport": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"type": "string", "minLength": 1, "maxLength": 128},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "nativeMaxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "substitutionAllowed": {"const": false},
        "loweringRequiresAcceptedNonInferiority": {"const": true}
      }
    },
    "packet": {
      "const": {
        "schema": "fleet-review-capsule/v1", "canonicalEncoding": "UTF8_NO_BOM_SORTED_KEYS_COMPACT_LF",
        "allAndOnlyOrderedSubjectBijection": true, "gitAndCommittedManifestBinding": true,
        "metadataInstructionFieldsAllowed": false, "silentTruncationAllowed": false,
        "maxCapsuleBytes": 65536, "maxCapsules": 4, "maxTotalCapsuleBytes": 262144
      }
    },
    "serialization": {
      "const": {
        "schema": "fleet-provider-final-review-request/v1", "internallyDerivedOnly": true,
        "callerSerializationAccepted": false, "trustedCapturedRawRequestHandleRequired": true,
        "countedParts": ["SYSTEM_PREFIX", "PROVIDER_PREFIX", "TRANSPORT_FRAMING", "PROMPT", "CAPSULES", "OUTPUT_PARAMETER", "TOOL_CONFIGURATION"]
      }
    },
    "tokenizer": {
      "const": {
        "trustedVersionAndArtifactRequired": true, "exactCapturedRequestBytesRequired": true,
        "maxExactSerializedInputTokens": 128000, "heuristicByteFallbackAllowed": false,
        "callerHiddenPrefixAssertionAccepted": false, "missingCapturedRawHandle": "REFUSE"
      }
    },
    "charges": {
      "const": {
        "trustedProviderNativeFunctionRequired": true,
        "dimensions": ["input", "cacheRead", "cacheCreationOrWrite", "output", "reasoning", "otherChargedDimensions"],
        "typedFiniteNonnegative": true, "fullSelectedNativeOutputAllowanceCharged": true,
        "cacheDisabledOrExactlyBounded": true, "otherUnknownConservativelyCharged": true,
        "unknownNeverZero": true
      }
    },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredQuotaWindows", "maxEvidenceAgeSeconds", "allWindowDimensionPairs", "completionReserveRequired", "foregroundReserveRequired", "reviewReserveRequired", "providerNativeReserveFloor", "unknownOrStale"],
      "properties": {
        "requiredQuotaWindows": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}},
        "maxEvidenceAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "allWindowDimensionPairs": {"const": true},
        "completionReserveRequired": {"const": true}, "foregroundReserveRequired": {"const": true},
        "reviewReserveRequired": {"const": true}, "providerNativeReserveFloor": {"const": 0.2},
        "unknownOrStale": {"const": "REFUSE"}
      }
    },
    "tools": {
      "const": {
        "providerDefinitions": [], "effectiveProviderTools": [], "effectiveLocalTools": [],
        "allowedTools": [], "allowedToolsSemantics": "APPROVAL_ONLY_NOT_CONTAINMENT",
        "hooks": [], "mcpServers": [], "discoveryAllowed": false,
        "duplicateOrConflictingFlagsAllowed": false
      }
    },
    "capabilities": {
      "const": {
        "brokerOwnedHandlesRequired": true, "hardOutputEqualsSelectedProfile": true,
        "fullChildTreeCustodyRequired": true, "handleBoundDeadlineSeconds": 3600,
        "callerBooleanOrDigestAuthority": false, "missing": "REFUSE"
      }
    },
    "lease": {
      "const": {
        "scope": "ATOMIC_HOST_WIDE_QUOTA_DOMAIN", "brokerOwnedHandleRequired": true,
        "acquireBeforeCensusAndCapacity": true, "revalidateImmediatelyBeforeSpawn": true,
        "holdThroughTerminalAccounting": true, "timeOnlyStealAllowed": false,
        "abaFields": ["ownerPid", "ownerProcessStartTime", "nonce", "generation"]
      }
    },
    "request": {
      "const": {
        "transactionalAuthorityLedgerRequired": true, "requestsPerAuthority": 1,
        "automaticRetry": false, "unevaluableConsumesAuthority": true,
        "freshAuthorityAfterUnevaluable": true, "qualityOrFunctionDowngradeAllowed": false
      }
    },
    "terminal": {
      "const": {
        "requestedAndEffectiveIdentityRequired": true, "reconcileAgainstReservation": true,
        "allNativeUsageRequired": true, "unknownChargesFullReservation": true,
        "identityMismatch": "UNEVALUABLE_ZERO_CREDIT", "accountBeforeLeaseRelease": true
      }
    },
    "conformance": {
      "const": {
        "adapterLabel": "CONFORMANCE_ONLY_ZERO_AUTHORITY", "productionAuthority": false,
        "runtimeEntryPointResult": "REFUSE_RUNTIME_NOT_INSTALLED"
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "path", "gitBlobOid", "sha256", "bytes"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 6},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "gitBlobOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"$ref": "#/$defs/sha"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
