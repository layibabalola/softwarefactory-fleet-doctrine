{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-production-wrapper-boundary-certification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "certificationId", "projectId", "issuedAt", "expiresAt",
    "wrapperExecutableSha256", "providerExecutableSha256", "launcherConfigSha256",
    "argvContractSha256", "launcherInventorySha256", "requestBoundaryMode",
    "brokerPermitCommand", "processServiceChokePoint", "directInvocationImpossible",
    "rawProviderEntrypointsStructurallyUnavailable", "fleetSecretsInheritedByProvider",
    "observerSecretsInheritedByProvider", "exactArgvRequired", "singleUsePermitRequired",
    "processTreeTerminationRequired", "watchdogCertificationSha256", "terminationObserverId",
    "terminationObserverKeySha256", "qualityObserverId", "qualityObserverKeySha256",
    "independentReviewSha256", "certificationHmacSha256"
  ],
  "properties": {
    "schema": {"const": "fleet-universal-production-wrapper-boundary-certification/v1"},
    "certificationId": {"type": "string", "pattern": "^boundary-[0-9a-f]{32}$"},
    "projectId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "wrapperExecutableSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "providerExecutableSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "launcherConfigSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "argvContractSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "launcherInventorySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requestBoundaryMode": {"const": "SINGLE_REQUEST_PROCESS"},
    "brokerPermitCommand": {"const": "brokered-single-request"},
    "processServiceChokePoint": {"const": true},
    "directInvocationImpossible": {"const": true},
    "rawProviderEntrypointsStructurallyUnavailable": {"const": true},
    "fleetSecretsInheritedByProvider": {"const": false},
    "observerSecretsInheritedByProvider": {"const": false},
    "exactArgvRequired": {"const": true},
    "singleUsePermitRequired": {"const": true},
    "processTreeTerminationRequired": {"const": true},
    "watchdogCertificationSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "terminationObserverId": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,63}$"},
    "terminationObserverKeySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualityObserverId": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,63}$"},
    "qualityObserverKeySha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "independentReviewSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "certificationHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
