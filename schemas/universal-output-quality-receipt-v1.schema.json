{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.invalid/schemas/universal-output-quality-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "leaseId", "requestId", "completedAt", "outputSha256", "qualitySubjectSha256", "providerUsageCheckpointSha256", "nonInferior", "independentReviewSha256", "receiptHmacSha256"],
  "properties": {
    "schema": {"const": "fleet-universal-output-quality-receipt/v1"},
    "receiptId": {"type": "string", "pattern": "^output-quality-[0-9a-f]{32}$"},
    "leaseId": {"type": "string", "pattern": "^lease-[0-9a-f]{32}$"},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "completedAt": {"type": "string", "format": "date-time"},
    "outputSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "qualitySubjectSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "providerUsageCheckpointSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonInferior": {"const": true},
    "independentReviewSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "receiptHmacSha256": {"type": "string", "pattern": "^hmac-sha256:[0-9a-f]{64}$"}
  }
}
