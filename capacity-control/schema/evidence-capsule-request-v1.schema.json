{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.local/fleet/evidence-capsule-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject_digest", "workspace_root", "max_payload_bytes", "items"],
  "properties": {
    "schema": {"const": "fleet-evidence-capsule-request/v1"},
    "subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workspace_root": {"type": "string", "minLength": 1},
    "max_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "start_line", "end_line", "purpose"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
